# Copy to .env.local to change these. Both default to the local FastAPI server.

# Where the UI reaches the FastAPI server (used by the /api proxy).
API_URL=http://127.0.0.1:8000

# The server address written into the code snippets your notebooks run.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Clerk (login). From the Clerk dashboard: Configure -> API keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
