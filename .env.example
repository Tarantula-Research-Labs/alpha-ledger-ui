# Copy to .env.local to change these. Both default to the local FastAPI server.

# Where the UI reaches the FastAPI server (used by the /api proxy).
API_URL=http://127.0.0.1:8000

# The shared key the /api route adds to every request (the server's API_KEY).
# Server-side only: never prefix it with NEXT_PUBLIC_, or browsers would see it.
LEDGER_API_KEY=

# The server address written into the code snippets your notebooks run.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Clerk (login). From the Clerk dashboard: Configure -> API keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
